{
  "name": "@trusttrace/verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "trusttrace": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bridge": "npm run build && node dist/bridgeServer.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
