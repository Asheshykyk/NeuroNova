# ==============================================================================
# TRUSTTRACE Environment Configuration Template (.env.example)
# RULE: DO NOT COMMIT REAL PRIVATE KEYS OR RPC CREDENTIALS TO GIT.
# ==============================================================================

# RPC Endpoints
LOCAL_RPC_URL=http://127.0.0.1:8545
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Smart Contract Addresses (populate after deployment)
EVIDENCE_ANCHOR_LOCAL_ADDRESS=
EVIDENCE_ANCHOR_AMOY_ADDRESS=

# Role Separation:
# EIP-712 Vault Signer: Signs batch commitments inside the isolated Evidence Vault ONLY.
# Relayer: Submits on-chain transactions and pays gas. Relayer is a separate key.
# RULE: Never use Hardhat default keys on a public network!
VAULT_SIGNER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
